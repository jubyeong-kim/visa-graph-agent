{
  "domain": "대한민국 체류자격·정착 절차",
  "model": {
    "chat": "gpt-4.1-mini",
    "judge": "gpt-4.1",
    "timeout": 120,
    "retries": 3,
    "workers": 8
  },
  "schema": {
    "nodes": [
      "Visa",
      "Procedure",
      "Requirement",
      "Organization",
      "Program",
      "Document"
    ],
    "relations": [
      [
        "Visa",
        "CONVERTS_TO",
        "Visa"
      ],
      [
        "Visa",
        "REQUIRES",
        "Requirement"
      ],
      [
        "Visa",
        "ALLOWS",
        "Procedure"
      ],
      [
        "Procedure",
        "HANDLED_BY",
        "Organization"
      ],
      [
        "Procedure",
        "SUBMITS",
        "Document"
      ],
      [
        "Requirement",
        "SATISFIED_BY",
        "Program"
      ],
      [
        "Program",
        "OPERATED_BY",
        "Organization"
      ],
      [
        "Visa",
        "PRECEDES",
        "Visa"
      ]
    ]
  },
  "traversal": {
    "max_hops": 3,
    "deepen_limit": 2,
